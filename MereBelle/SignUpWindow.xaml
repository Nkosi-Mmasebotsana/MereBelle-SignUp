<Window x:Class="MereBelle.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mère Belle – Create Account" Height="740" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF0F5" FontFamily="Segoe UI">
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5A2A3C"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5A2A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFF9FB" BorderBrush="#F4C2D7" BorderThickness="1.5" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5A2A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="#FFF9FB" BorderBrush="#F4C2D7" BorderThickness="1.5" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#E75480" CornerRadius="22" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D63C6E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F4B6CB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Border Background="White" CornerRadius="20" Padding="32,28">
            <Border.Effect>
                <DropShadowEffect Color="#E75480" Opacity="0.18" BlurRadius="25" ShadowDepth="4"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Mère Belle" FontFamily="Georgia" FontSize="34" FontStyle="Italic"
                           Foreground="#B0245A" HorizontalAlignment="Center"/>
                <TextBlock Text="beauty, lovingly nurtured" FontSize="13" Foreground="#E75480"
                           HorizontalAlignment="Center" Margin="0,2,0,18"/>
                <TextBlock Text="Create your account" FontSize="18" FontWeight="SemiBold"
                           Foreground="#5A2A3C" HorizontalAlignment="Center"/>

                <TextBlock Text="Full Name" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="FullNameBox"/>

                <TextBlock Text="Email Address" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="EmailBox"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox"/>

                <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="ConfirmBox"/>

                <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                           TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="18"/>

                <Button x:Name="CreateButton" Content="Create Account"
                        Style="{StaticResource PinkButton}" Margin="0,10,0,0"
                        Click="CreateAccount_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>