<Window x:Class="MereBelle.VerifyCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mère Belle – Verify Email" Height="440" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FFF0F5" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="CharacterCasing" Value="Upper"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#5A2A3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#FFF9FB" BorderBrush="#F4C2D7" BorderThickness="1.5" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#E75480" CornerRadius="22" Padding="0,12">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D63C6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Border Background="White" CornerRadius="20" Padding="32,28">
            <Border.Effect>
                <DropShadowEffect Color="#E75480" Opacity="0.18" BlurRadius="25" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Mère Belle" FontFamily="Georgia" FontSize="28" FontStyle="Italic"
                           Foreground="#B0245A" HorizontalAlignment="Center"/>
                <TextBlock Text="Check your inbox" FontSize="17" FontWeight="SemiBold"
                           Foreground="#5A2A3C" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                <TextBlock x:Name="InstructionText" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="#8A5A6C" FontSize="12" Margin="0,0,0,16"/>

                <TextBox x:Name="CodeBox" MaxLength="6" Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="12"
                           TextWrapping="Wrap" Margin="0,4,0,0" MinHeight="18" HorizontalAlignment="Center"/>

                <Button Content="Verify Account" Style="{StaticResource PinkButton}"
                        Margin="0,10,0,0" Click="Verify_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>